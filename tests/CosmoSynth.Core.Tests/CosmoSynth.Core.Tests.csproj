<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless test host for the engine-free part of CosmoSynth.

    CosmoSynth.Core deliberately has no UnityEngine dependency, which means it can be compiled
    and exercised by a plain .NET SDK with no Unity Editor, no licence and no graphics device.
    That is what makes the orbital mechanics testable in CI and in a terminal.

    The Core sources are *linked*, not copied: this project compiles the exact same files that
    Unity compiles from Assets/CosmoSynth/Core, so the two can never drift apart.

    Uses a zero-dependency runner (see TestHarness.cs) rather than xUnit/NUnit so the suite
    restores and runs with no network access.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CosmoSynth.Tests</RootNamespace>
    <AssemblyName>CosmoSynth.Core.Tests</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The library under test, shared verbatim with the Unity project. -->
    <Compile Include="../../unity/Assets/CosmoSynth/Core/**/*.cs">
      <Link>Core/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>

    <!-- The tests themselves. -->
    <Compile Include="*.cs" />

    <!-- Real JPL Horizons ephemerides, checked in so the validation runs offline. -->
    <Content Include="fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
