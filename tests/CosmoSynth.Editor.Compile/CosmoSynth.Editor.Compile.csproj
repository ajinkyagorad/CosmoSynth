<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile-check for the editor layer (ServerBuild, XrSetup, PlayModeShot, SceneBuilder,
    CosmoUrpConfig), without opening the Unity Editor.

    The tooling report's own "what it cannot prove" column said: "Nothing about ... the editor
    layer (no CosmoSynth.Editor.Compile project exists yet)". That gap is expensive here, because
    the editor layer is where every XR, URP and build setting is written, it is the layer with the
    most version-sensitive API surface in the project, and the only way to find a misremembered
    name was a five-minute batchmode launch behind a global lock.

    run-tests.sh already looks for this project by exactly this path and builds it when present.

    This builds a library, never runs it. Behaviour still needs the editor: what this catches is a
    method that moved, a signature that changed, an enum member that does not exist.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CosmoSynth.Editor.Compile</AssemblyName>
    <RootNamespace>CosmoSynth.EditorTools</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1701;CS1702;CS0436</NoWarn>
    <UnityRoot>$(HOME)/Unity/Hub/Editor/6000.5.5f1/Editor/Data</UnityRoot>
    <UnityManaged>$(UnityRoot)/Managed/UnityEngine</UnityManaged>
    <UnityScriptAssemblies>$(MSBuildThisFileDirectory)../../unity/Library/ScriptAssemblies</UnityScriptAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Assets/CosmoSynth/Core/**/*.cs">
      <Link>Core/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="../../unity/Assets/CosmoSynth/Runtime/**/*.cs">
      <Link>Runtime/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="../../unity/Assets/CosmoSynth/Editor/**/*.cs">
      <Link>Editor/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

